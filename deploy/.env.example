APP_PORT=8080
POSTGRES_DB=sentinel
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=replace-with-url-safe-random-password
CREDENTIAL_MASTER_KEY=replace-with-base64-encoded-32-byte-key
CREDENTIAL_KEY_VERSION=v1
API_ADMIN_TOKEN=replace-with-at-least-32-random-characters
AUTH_BOOTSTRAP_USERNAME=admin
AUTH_BOOTSTRAP_PASSWORD=replace-with-strong-initial-password
AUTH_COOKIE_SECURE=false
AUTH_SESSION_TTL_SECONDS=43200
AUTH_LOCK_THRESHOLD=5
AUTH_LOCK_SECONDS=900
ALLOWED_ORIGINS=auto
HTTPS_PORT=443
TLS_CERT_PATH=/etc/letsencrypt/live/sentinel.example.com/fullchain.pem
TLS_KEY_PATH=/etc/letsencrypt/live/sentinel.example.com/privkey.pem
KNOWLEDGE_TRUSTED_KEYS={}
KNOWLEDGE_SOURCE_CONNECTORS={}
KNOWLEDGE_SYNC_INTERVAL_SECONDS=14400
MONITORING_INTERVAL_SECONDS=300
SENTINEL_PROBE_ALLOWED_CIDRS=
TERMINAL_TICKET_TTL_SECONDS=30
TERMINAL_IDLE_TIMEOUT_SECONDS=900
TERMINAL_MAX_DURATION_SECONDS=14400
TERMINAL_MAX_CONNECTIONS=10
# AI endpoint, model, API key and timeout are managed by administrators in the system page.
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
NPM_REGISTRY=https://registry.npmmirror.com
