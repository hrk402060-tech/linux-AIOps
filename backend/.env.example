DATABASE_URL=postgresql+psycopg://sentinel:change-me@postgres:5432/sentinel
CREDENTIAL_MASTER_KEY=replace-with-base64-encoded-32-byte-key
CREDENTIAL_KEY_VERSION=v1
API_ADMIN_TOKEN=replace-with-at-least-32-random-characters
AUTH_BOOTSTRAP_USERNAME=admin
AUTH_BOOTSTRAP_PASSWORD=replace-with-strong-initial-password
AUTH_COOKIE_SECURE=false
AUTH_SESSION_TTL_SECONDS=43200
AUTH_LOCK_THRESHOLD=5
AUTH_LOCK_SECONDS=900
ALLOWED_ORIGINS=auto
# Kubernetes access is disabled until precise API target ranges are approved.
KUBERNETES_API_ALLOWED_CIDRS=
KUBERNETES_API_DENIED_CIDRS=
KUBERNETES_COLLECTION_WORKERS_ENABLED=true
KUBERNETES_HELM_TRUSTED_CHARTS=[]
KUBERNETES_HELM_BINARY=helm
KUBERNETES_HELM_REHEARSAL_ENABLED=false
KUBERNETES_HELM_REHEARSAL_CLUSTER_ID=
KUBERNETES_HELM_REHEARSAL_ENDPOINT=
KUBERNETES_HELM_REHEARSAL_NAMESPACE=
KUBERNETES_HELM_REHEARSAL_CREDENTIALS_DIR=
KUBERNETES_HELM_EXECUTION_ENABLED=false
KUBERNETES_HELM_EXECUTION_CLUSTER_ID=
KUBERNETES_HELM_EXECUTION_ENDPOINT=
KUBERNETES_HELM_EXECUTION_NAMESPACE=
KUBERNETES_HELM_EXECUTION_CREDENTIALS_DIR=
