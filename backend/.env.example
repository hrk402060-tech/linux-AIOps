DATABASE_URL=postgresql+psycopg://sentinel:change-me@postgres:5432/sentinel
CREDENTIAL_MASTER_KEY=replace-with-base64-encoded-32-byte-key
CREDENTIAL_KEY_VERSION=v1
API_ADMIN_TOKEN=replace-with-at-least-32-random-characters
AUTH_BOOTSTRAP_USERNAME=admin
AUTH_BOOTSTRAP_PASSWORD=replace-with-strong-initial-password
AUTH_COOKIE_SECURE=false
AUTH_SESSION_TTL_SECONDS=43200
AUTH_LOCK_THRESHOLD=5
AUTH_LOCK_SECONDS=900
ALLOWED_ORIGINS=auto
